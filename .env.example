# Copy to .env.local and fill in. Only AUTH_SECRET is required.

# Random string, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Database. Leave unset for a local SQLite file at data/watchtrail.db.
# For a shared/hosted install use a free Turso database:
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=your-token
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: poster artwork from TMDB (https://www.themoviedb.org/settings/api).
# Set either a v3 API key or a v4 read access token.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Optional: set to "false" to stop new people from creating accounts.
ALLOW_SIGNUPS=true
